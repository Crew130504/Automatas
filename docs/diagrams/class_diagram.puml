@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
title Diagrama de clases de AutomatasPaint

class Automaton {
  +alphabet: list[str]
  +states: list[str]
  +initial: str
  +finals: set[str]
  +transitions: dict
  +kind: str
  +validate()
  +epsilon_closure(states)
  +move(states, symbol)
  +simulate(text)
  +to_dfa()
}

class AutomataApp {
  -root: Tk
  -entries: dict
  -current_path: list
  +refresh_table()
  +build_automaton()
  +fill_from(automaton)
  +convert()
  +evaluate()
  +draw()
  +export_png()
  +run()
}

class Tkinter <<framework>>
AutomataApp --> Automaton : crea y usa
AutomataApp --> Tkinter : interfaz
@enduml
